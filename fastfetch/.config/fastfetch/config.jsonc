{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "color": { "1": "blue" }, "padding": { "left": 2, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "blue", "title": "blue" } },
  "modules": [
    "title",
    { "type": "os", "key": "󰣇 os " },
    { "type": "kernel", "key": " krn" },
    { "type": "wm", "key": " wm " },
    { "type": "shell", "key": " sh " },
    { "type": "terminal", "key": " trm" },
    { "type": "packages", "key": "󰏖 pkg" },
    { "type": "memory", "key": "󰍛 mem" },
    { "type": "uptime", "key": "󰔟 up " }
  ]
}
