@import "~/.config/rofi/colors/matugen.rasi"

* { font: "JetBrainsMono Nerd Font 14"; }

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 760px;
    border: 1px;
    border-color: @selected;
    border-radius: 24px;
    background-color: @background;
}
mainbox { padding: 28px; spacing: 20px; background-color: transparent; children: [ "message", "listview" ]; }
message { background-color: transparent; border: 0; padding: 0; }
textbox { background-color: transparent; border: 0; padding: 0; text-color: @foreground; horizontal-align: 0.5; }
listview {
    columns: 5;
    lines: 1;
    spacing: 18px;
    fixed-columns: true;
    border: 0;
    background-color: transparent;
}
element {
    padding: 36px 0px;
    border: 0;
    border-radius: 24px;
    background-color: @background-alt;
    text-color: @foreground;
    children: [ "element-text" ];
}
element-text { font: "JetBrainsMono Nerd Font 34"; padding: 0; border: 0; horizontal-align: 0.5; vertical-align: 0.5; background-color: transparent; text-color: inherit; }
element selected.normal { background-color: @selected; text-color: @background; }
