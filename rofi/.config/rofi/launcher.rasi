@import "~/.config/rofi/colors/matugen.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
}

* { font: "JetBrainsMono Nerd Font 11"; }

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 55%;
    height: 620px;
    border: 1px;
    border-color: @selected;
    border-radius: 24px;
    background-color: @background;
}
mainbox { padding: 0; spacing: 0; background-color: transparent; children: [ "header", "listview" ]; }
header {
    padding: 66px 140px;
    background-image: url("~/.cache/current_wall", width);
    border-radius: 24px 24px 0 0;
    children: [ "inputbar" ];
}
inputbar {
    padding: 12px 20px;
    spacing: 10px;
    border-radius: 999px;
    background-color: @background;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}
prompt { background-color: transparent; text-color: @selected; }
entry { background-color: transparent; text-color: @foreground; placeholder: "Buscar..."; placeholder-color: @foreground; }
listview {
    columns: 6;
    lines: 3;
    spacing: 12px;
    padding: 20px;
    fixed-columns: true;
    fixed-height: true;
    expand: true;
    dynamic: false;
    scrollbar: false;
    background-color: transparent;
}
element {
    orientation: vertical;
    padding: 14px 6px;
    spacing: 8px;
    border-radius: 16px;
    background-color: transparent;
    text-color: @foreground;
}
element-icon { size: 56px; horizontal-align: 0.5; background-color: transparent; }
element-text { horizontal-align: 0.5; background-color: transparent; text-color: inherit; }
element selected.normal { background-color: @selected-soft; text-color: @foreground; }
