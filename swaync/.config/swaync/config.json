{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,
  "control-center-width": 420,
  "notification-window-width": 380,
  "notification-icon-size": 56,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "widgets": ["title", "dnd", "mpris", "volume", "backlight", "notifications"],
  "widget-config": {
    "title": { "text": "Notificaciones", "clear-all-button": true, "button-text": "Limpiar" },
    "dnd": { "text": "No molestar" },
    "mpris": { "image-size": 56 },
    "volume": { "label": "󰕾" },
    "backlight": { "label": "󰃟", "device": "intel_backlight" }
  }
}
