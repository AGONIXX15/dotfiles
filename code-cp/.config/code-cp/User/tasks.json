{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cp: build & run",
      "type": "shell",
      "command": "g++ -std=c++20 -O2 -Wall -Wextra -DLOCAL \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && if [ -f \"${fileDirname}/input.txt\" ]; then \"${fileDirname}/${fileBasenameNoExtension}\" < \"${fileDirname}/input.txt\"; else \"${fileDirname}/${fileBasenameNoExtension}\"; fi",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": "$gcc"
    }
  ]
}
